{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BellMeter",
  "version": "0.2.0",
  "identifier": "com.bellmeter.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BellMeter",
        "width": 800,
        "height": 760,
        "minWidth": 440,
        "minHeight": 420,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://assets.playnccdn.com; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "license": "../LICENSE",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Turkish"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGOTREQzAwOUU2OEI5NEMKUldSTXVXaWVBTnlVSC9nczF3dFZrY2puNXlXc2J6Qjh6Q2FncGhXeGIvbVpQakFyMXpUUEdzd2kK",
      "endpoints": [
        "https://github.com/Eren-Ozcan/bellmeter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "BellMeter"
}