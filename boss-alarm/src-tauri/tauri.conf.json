{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AION2 Boss Alarm",
  "version": "0.1.0",
  "identifier": "com.aion2bossalarm.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AION2 Boss Alarm",
        "width": 560,
        "height": 760,
        "minWidth": 440,
        "minHeight": 420,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://assets.playnccdn.com; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "license": "../LICENSE"
  }
}